rules_version = '2';
// La app no sube archivos hoy. Cerrado hasta que vuelvan las fotos; entonces,
// ruta users/{uid}/... con request.auth.uid == uid (ver docs/SEGURIDAD.md, C1).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
